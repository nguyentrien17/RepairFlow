# ============================================================================
# CẤU HÌNH MÔI TRƯỜNG & CƠ SỞ DỮ LIỆU REPAIRFLOW (MySQL + Drizzle ORM)
# Mặc định NODE_ENV="production" và ENABLE_DEV_TOOLS="false" để bảo mật.
# ============================================================================
NODE_ENV="production"
ENABLE_DEV_TOOLS="false"
PORT="3000"
APP_URL="http://localhost:5173"

# Reverse proxy phía trước app (dùng để lấy IP thật của client cho rate limit & audit log)
# - "false" (mặc định): app nhận kết nối trực tiếp, KHÔNG tin header X-Forwarded-For
# - "1": có 1 lớp proxy (Nginx / Cloudflare Tunnel...) đứng trước app
# - "loopback": Nginx chạy cùng máy, proxy tới 127.0.0.1
# Không dùng "true" (server sẽ từ chối): client có thể tự giả mạo IP.
TRUST_PROXY="false"

# Cấu hình kết nối MySQL (XAMPP / Laragon / MySQL Workbench / Docker)
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD=""
DB_NAME="repairflow"

# BẮT BUỘC ĐỔI KHÓA BÍ MẬT TRƯỚC KHI CHẠY (Server sẽ từ chối chạy nếu giữ nguyên giá trị mẫu này)
JWT_SECRET="CHANGE_ME_JWT_SECRET_MIN_32_CHARS"
DEVICE_SECRET_KEY="CHANGE_ME_32_BYTES_AES256GCM_KEY!"
